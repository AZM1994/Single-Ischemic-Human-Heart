inner_join(LOO_DEGs_target_celltype_filtered %>% group_by(Gene) %>% summarise(mean_log2FC = mean(avg_log2FC), .groups = 'drop'), by = "Gene") %>%
arrange(mean_log2FC) %>% pull(Gene)
